# Database (Neon Postgres connection string)
DATABASE_URL=postgres://user:password@host/dbname
DB_SSL=true

PORT=4000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Google OAuth (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Student/professor frontend origin — used to build Stripe Checkout success/cancel redirect URLs
FRONTEND_URL=http://localhost:3000

# Seeded admin account (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@officehours.dev
SEED_ADMIN_PASSWORD=ChangeMe123!

# Stripe (test mode keys, from Stripe Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Gmail SMTP App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudinary (avatar uploads)
CLOUDINARY_URL=

# TURN server for WebRTC (Metered.ca Open Relay free tier)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
